{
  "name": "hermes",
  "version": "0.1.0",
  "private": true,
  "description": "Hermes — open-source real-time chat platform (Web4 master spec). Monorepo root.",
  "packageManager": "bun@1.2.5",
  "engines": {
    "bun": ">=1.2"
  },
  "scripts": {
    "build": "turbo run build",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "dev:api": "bun --filter @hermes/api dev",
    "dev:gateway": "bun --filter @hermes/gateway dev",
    "dev:media": "bun --filter @hermes/media dev",
    "schema:generate": "turbo run schema:generate",
    "infra:up": "docker compose -f infra/docker-compose.yml up -d",
    "infra:down": "docker compose -f infra/docker-compose.yml down"
  },
  "devDependencies": {
    "turbo": "^2.5.0"
  }
}
