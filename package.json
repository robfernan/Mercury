{
  "name": "hermes",
  "version": "0.1.0",
  "private": true,
  "description": "Hermes — open-source real-time chat platform (Web4 master spec). Monorepo root.",
  "packageManager": "bun@1.2.5",
  "engines": {
    "bun": ">=1.2"
  },
  "scripts": {
    "build": "turbo run build",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "core:build": "cd core/crypto-engine && cargo build --release",
    "chat:run": "cd apps/chat && flutter run -d windows"
  },
  "devDependencies": {
    "turbo": "^2.5.0"
  }
}
